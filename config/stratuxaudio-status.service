[Unit]
Description=StratuxAudio status page service (now playing, health, level, EQ, mono; port 8090)
After=shairport-sync.service

[Service]
Type=simple
# Runs as root only so it can save settings on the Stratux settings partition
# (/boot/firmware, FAT, root-owned), switch shairport's mono mode (one line of its
# config, then a restart) and set its equalizer over D-Bus. Nothing beyond that:
# no capabilities, a read-only system, and write access to three places.
SupplementaryGroups=audio
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/tmp /boot/firmware /etc/shairport-sync.conf
ProtectHome=yes
PrivateDevices=no
ExecStart=/usr/bin/python3 /usr/local/lib/stratuxaudio/stratuxaudio-status.py
Restart=always
RestartSec=5
# Same rule as shairport: never compete with the ADS-B work.
Nice=15
CPUWeight=10
CPUQuota=15%
MemoryMax=48M

[Install]
WantedBy=multi-user.target
